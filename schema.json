{
  "database_schema": {
    "E506": {
      "table_info": { "description": "รายงานผู้ป่วยระบาดวิทยาพื้นฐาน (เดิม)" },
      "fields": {
        "id": { "type": "int", "length": 11, "required": true, "extra": "auto_increment" },
        "uuid": { "type": "string", "length": 40, "required": true, "comment": "Auto gen" },
        "disease": { "type": "string", "length": 250 },
        "disease_code": { "type": "string", "length": 4, "comment": "รหัสโรค" },
        "icd_10": { "type": "string", "length": 8, "comment": "ICD-10" },
        "lab_method": { "type": "string", "length": 120, "comment": "วิธีตรวจ" },
        "lab_case": { "type": "string", "length": 20 },
        "lab_result": { "type": "text", "comment": "ผลตรวจ Lab" },
        "lab_remark": { "type": "text" },
        "titlename": { "type": "string", "length": 60, "comment": "คำนำหน้า" },
        "firstname": { "type": "string", "length": 120, "comment": "ชื่อ" },
        "lastname": { "type": "string", "length": 160, "comment": "นามสกุล" },
        "hosp_no": { "type": "string", "length": 20, "comment": "HN" },
        "citizen_id": { "type": "string", "length": 20, "comment": "เลขบัตรประชาชน" },
        "passport_id": { "type": "string", "length": 20, "comment": "พาสปอร์ต" },
        "parent_name": { "type": "string", "length": 250 },
        "parent_ocuupation": { "type": "string", "length": 250 },
        "gender": { "type": "string", "length": 8, "comment": "เพศ (รหัส)" },
        "birthdate": { "type": "date" },
        "age_year": { "type": "string", "length": 8, "default": "0" },
        "age_month": { "type": "string", "length": 4, "default": "0" },
        "age_day": { "type": "string", "length": 4, "default": "0" },
        "married_status": { "type": "string", "length": 20, "comment": "สถานภาพ" },
        "nationality_code": { "type": "string", "length": 8 },
        "nationality": { "type": "string", "length": 120 },
        "work_code": { "type": "string", "length": 8 },
        "work_location": { "type": "string", "length": 250 },
        "address_no": { "type": "string", "length": 255 },
        "moo": { "type": "string", "length": 40 },
        "subdistrict_code": { "type": "string", "length": 8 },
        "district": { "type": "string", "length": 120 },
        "province": { "type": "string", "length": 120 },
        "contact_mobile": { "type": "string", "length": 80 },
        "patient_sick": { "type": "date", "comment": "เริ่มป่วย" },
        "patient_found": { "type": "date", "comment": "วันที่รับรักษา" },
        "patient_status": { "type": "string", "length": 60, "comment": "สภาพผู้ป่วย" },
        "report_date": { "type": "date" },
        "rec_status": { "type": "string", "length": 20, "default": "active" }
      }
    },
    "D506": {
      "table_info": { "description": "Digital 506 (โครงสร้างใหม่สำหรับงานระบาด)" },
      "fields": {
        "epidem_report_guid": { "type": "string", "length": 38, "required": true },
        "hospital_code": { "type": "string", "length": 5 },
        "cid": { "type": "string", "length": 15 },
        "treated_date": { "type": "date" },
        "passport_no": { "type": "string", "length": 20 },
        "prefix": { "type": "string", "length": 30 },
        "first_name": { "type": "string", "length": 150 },
        "last_name": { "type": "string", "length": 150 },
        "nationality": { "type": "string", "length": 3 },
        "gender": { "type": "number", "length": 1, "comment": "ต้องเป็น smallint(1)" },
        "birth_date": { "type": "date" },
        "age_y": { "type": "number", "length": 3 },
        "age_m": { "type": "number", "length": 2 },
        "age_d": { "type": "number", "length": 2 },
        "marital_status_id": { "type": "number", "length": 1 },
        "chw_code": { "type": "string", "length": 2, "comment": "รหัสจังหวัด" },
        "amp_code": { "type": "string", "length": 2, "comment": "รหัสอำเภอ" },
        "tmb_code": { "type": "string", "length": 2, "comment": "รหัสตำบล" },
        "occupation": { "type": "string", "length": 4 },
        "diagnosis_date": { "type": "date" },
        "onset_date": { "type": "date", "comment": "วันที่เริ่มป่วย" },
        "death_date": { "type": "date" },
        "diagnosis_icd10": { "type": "string", "length": 20 },
        "epidem_person_status_id": { "type": "number", "length": 1 },
        "location_gis_latitude": { "type": "string", "length": 20 },
        "location_gis_longitude": { "type": "string", "length": 20 },
        "lab_report_result": { "type": "text" },
        "tmlt_code": { "type": "string", "length": 10 },
        "update_datetime": { "type": "timestamp", "extra": "on update current_timestamp()" },
        "source_system": { "type": "string", "length": 10 }
      }
    }
  }
}